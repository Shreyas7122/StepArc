# ── Copy this to .env and fill in your values ──────────────────────────────
# NEVER commit .env to git

# Google Gemini API key  (get at https://aistudio.google.com/app/apikey)
API_KEY=your_gemini_api_key_here

# ── Local dev ───────────────────────────────────────────────────────────────
# Vite reads this to point the frontend at your local backend
# (copy this line to .env.local for dev, leave blank for production)
VITE_API_URL=http://localhost:8000

# ── Production ──────────────────────────────────────────────────────────────
# Set VITE_API_URL in Vercel dashboard to your Railway/Render backend URL:
# VITE_API_URL=https://steparc-backend.railway.app

# ── Supabase (optional — for multi-device sync & user accounts) ─────────────
# VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here
